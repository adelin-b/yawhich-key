{
  "name": "yawhich-key",
  "version": "1.0.0",
  "description": "Universal which-key shortcut manager for your entire computer",
  "type": "module",
  "author": "Adelin B",
  "repository": {
    "type": "git",
    "url": "https://github.com/adelin-b/yawhich-key.git"
  },
  "homepage": "https://github.com/adelin-b/yawhich-key",
  "keywords": ["yawhich-key", "which-key", "keyboard", "shortcuts", "macos", "tauri"],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
